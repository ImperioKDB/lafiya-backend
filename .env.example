# ALAT Playground sandbox (Wallet Services -- Account Management API).
# Get WEMA_API_KEY by subscribing to that product at playground.alat.ng
# with an Application, then generating keys. Never commit the real value.
WEMA_BASE_URL=https://apiplayground.alat.ng
WEMA_API_KEY=

# Africa's Talking USSD sandbox. Set to the exact service code shown in
# the dashboard after creating the channel (USSD -> Create Channel) --
# from the shared code *384# plus the assigned channel, typically
# something like *384*112#. Confirm the literal string the dashboard
# displays once the channel exists rather than assuming the format.
# Leave blank to skip the check entirely (see app/core/config.py).
USSD_SERVICE_CODE=
