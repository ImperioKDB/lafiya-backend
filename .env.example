# Supabase project: LAFIYA (ref ouujmuiyqndvsrtakxft, eu-west-1)
# The earlier ref (tiiyrrzxfnwsgnhqpgch) was superseded -- do not use it.
# Get these values from Supabase dashboard -> Project Settings -> API,
# from the "Legacy API Keys" tab specifically (service_role, not the
# newer sb_secret_ key -- see 00_START_HERE.md for why).
SUPABASE_URL=https://ouujmuiyqndvsrtakxft.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Comma-separated emails that get role=admin with no chws/doctors/pharmacies row
ADMIN_EMAILS=you@example.com

# ALAT Playground sandbox (Wallet Services -- Account Management API).
# Get WEMA_API_KEY by subscribing to that product at playground.alat.ng
# with an Application, then generating keys. Never commit the real value.
WEMA_BASE_URL=https://apiplayground.alat.ng
WEMA_API_KEY=

# Africa's Talking USSD sandbox. Set to the exact service code shown in
# the dashboard after creating the channel -- confirmed as *384*66353#
# for this project, not the *384*112# placeholder guessed earlier.
USSD_SERVICE_CODE=*384*66353#

# Africa's Talking SMS -- same account/app as USSD. Username is literally
# "sandbox" in sandbox mode. Get the API key from Settings -> API Key in
# the Africa's Talking dashboard.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# Base URL of the frontend, once it exists. The guarantor confirmation
# SMS links here -- leave blank until a real frontend is deployed; the
# backend token contract works regardless.
FRONTEND_BASE_URL=
